{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": ["mise.lock", "test/fixtures"],
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  // Python's own convention, which the ruff plugin otherwise takes from the
  // indentWidth above.
  "ruff": { "indentWidth": 4 },
  "exec": {
    "commands": [
      {
        // StyLua reads stylua.toml from the working directory.
        "command": "stylua --stdin-filepath {{file_path}} -",
        "exts": ["lua"],
      },
    ],
  },
  "plugins": [
    "npm:@dprint/oxc@0.49.0",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    "npm:@dprint/ruff@0.11.3",
  ],
}
